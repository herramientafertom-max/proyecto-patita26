NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# Keep true outside local development. Use a CA trusted by the container/host.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace-with-at-least-24-random-characters
ENABLE_DEMO_AUTH=true
DEMO_PASSWORD=replace-local-demo-password
# UUID de usuario Auth vinculado a cada perfil demo. El backend lo resuelve mediante
# public.autenticar_usuario; no realiza lecturas directas que eludan el bootstrap RLS.
DEMO_AUTH_USER_ID_ADMINISTRADOR=
DEMO_AUTH_USER_ID_SUPERVISOR=
DEMO_AUTH_USER_ID_REPONEDOR=
DEMO_AUTH_USER_ID_REPONEDOR_EXTERNO=
CORS_ORIGIN=http://localhost:5173

# Autenticación productiva con Supabase Auth (opcional en desarrollo).
# Deja las tres vacías para seguir usando solo el modo demo local.
# Usa SUPABASE_JWT_SECRET (proyectos legacy, HS256) o SUPABASE_URL (JWKS remoto), no ambas.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Backend-only Storage credential. Never expose it through a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

VITE_API_URL=
# Login con Supabase Auth en el navegador. Solo la URL del proyecto y la clave pública
# anon/publishable; nunca la service_role. Vacías = formulario demo local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
